---
interface Props {
  src: string;
  title?: string;
  caption?: string;
}

const { src, title = '', caption } = Astro.props;
---

<figure class="video-embed">
  <div class="frame">
    <iframe src={src} title={title} allowfullscreen loading="lazy"></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-embed {
    margin: 0 0 24px;
  }
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    font-style: italic;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    line-height: 1.8em;
    margin-top: 8px;
  }
</style>
