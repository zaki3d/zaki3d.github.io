---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
const hasCaptionSlot = Astro.slots.has('caption');
---

<figure class="figure">
  <Image src={src} alt={alt} />
  {(caption || hasCaptionSlot) && (
    <figcaption><slot name="caption">{caption}</slot></figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 0 0 24px;
  }
  .figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .figure figcaption {
    font-style: italic;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    line-height: 1.8em;
    margin-top: 8px;
  }
</style>
