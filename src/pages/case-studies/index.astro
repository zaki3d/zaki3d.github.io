---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Case Studies — Zaki Salleh">
  <div slot="header">
    <SiteNav sectionLabel="Case Studies" sectionHref="/case-studies/" />
  </div>

  <div class="listing">
    <h1>Case Studies</h1>
    {studies.length === 0 && <p class="empty">No case studies published yet — check back soon.</p>}
    <ul>
      {studies.map((study) => (
        <li>
          <a href={`/case-studies/${study.id}/`}>{study.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .listing {
    padding: 32px 0;
  }
  .listing h1 {
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 32px;
    color: var(--heading);
    margin: 0 0 24px;
  }
  .empty {
    font-style: italic;
    color: var(--muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 16px;
  }
</style>
